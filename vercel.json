{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{frontend/**,node_modules/**,plots/**,reports/**,*.ipynb,*.csv,*.png,*.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/match", "destination": "/api/index" },
    { "source": "/predict_survival", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ]
}